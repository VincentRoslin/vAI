# Normalize line endings to LF in the repo; check out native.
* text=auto eol=lf

# Explicitly binary
*.png binary
*.ico binary
*.icns binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.gguf binary
*.safetensors binary
*.bin binary

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
